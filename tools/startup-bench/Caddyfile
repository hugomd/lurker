	bind 127.0.0.1
	encode gzip
	reverse_proxy 127.0.0.1:8010
}

# Diagnostic ablation: use the existing small icon for both favicon requests.
http://127.0.0.1:8012 {
	bind 127.0.0.1
	encode gzip
	@icons path /lurker-icon.svg /favicon.ico
	rewrite @icons /favicon-32.png
	reverse_proxy 127.0.0.1:8010
}
